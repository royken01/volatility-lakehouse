# Copy this file to .env and fill in your real values. Never commit .env.

# --- Cloudflare R2 Data Catalog (Iceberg REST catalog, built into R2) ---
# From: wrangler r2 bucket catalog enable <bucket-name>
R2_CATALOG_URI=https://catalog.cloudflarestorage.com/your_account_id/your-bucket-name
R2_CATALOG_WAREHOUSE=your_account_id_your-bucket-name
# From: R2 -> Manage API Tokens -> new token scoped to "R2 Data Catalog" permission
R2_CATALOG_TOKEN=your_r2_data_catalog_token

CATALOG_NAME=volatility_lakehouse      # Iceberg catalog / namespace prefix (one per study if you like)

# --- Optional: only needed if you also use direct S3 access (e.g. manual
# backups/exports) outside of the R2 Data Catalog path above ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# --- MLflow ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT=event_volatility
MLFLOW_MODEL_PREFIX=event_vol

# --- Framework settings file (asset, windows, event types, news); see configs/ ---
# LAKEHOUSE_CONFIG=configs/crude_oil_thesis.toml

# --- Economic calendar (optional) ---
# Free key from https://fred.stlouisfed.org/docs/api/api_key.html, used by `vol-lakehouse calendar fred`
# FRED_API_KEY=your_fred_api_key
